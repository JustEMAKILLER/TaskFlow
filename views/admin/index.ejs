<section class="page-heading"><div><div class="eyebrow">CONTROL DEL SISTEMA</div><h1>Panel de administracion</h1><p class="muted">Resumen general de usuarios y tareas registradas.</p></div><a class="button button-secondary" href="/tasks">Ver todas las tareas</a></section>
<div class="stats-grid"><article class="stat-card"><span>Usuarios registrados</span><strong><%= usersCount %></strong></article><article class="stat-card"><span>Tareas registradas</span><strong><%= tasksCount %></strong></article></div>
<section class="admin-latest"><h2>Ultimas tareas creadas</h2><% if (!latestTasks.length) { %><p class="muted">Todavia no hay tareas.</p><% } else { %><div class="simple-list"><% latestTasks.forEach(task => { %><a href="/tasks/<%= task._id %>"><span><strong><%= task.title %></strong><small><%= task.owner ? task.owner.email : 'Usuario eliminado' %></small></span><span class="status status-<%= task.status %>"><%= task.status === 'pending' ? 'Pendiente' : task.status === 'in_progress' ? 'En progreso' : 'Completada' %></span></a><% }) %></div><% } %></section>
