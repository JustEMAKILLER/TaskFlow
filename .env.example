# Copia este archivo y renombralo a .env. Nunca subas .env a GitHub.
NODE_ENV=development
PORT=3000

# Pega aqui la cadena de conexion de MongoDB Atlas o tu MongoDB local.
DATABASE_URL=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/taskflow?retryWrites=true&w=majority

# Genera dos valores diferentes y aleatorios (ver la guia de instalacion).
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_LARGO
COOKIE_SECRET=CAMBIAR_POR_OTRO_SECRETO_ALEATORIO_LARGO

# Duracion del JWT. Ejemplo: 1d = un dia.
JWT_EXPIRES_IN=1d
